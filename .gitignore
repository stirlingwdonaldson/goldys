.DS_Store
Claude outputs/

# Playwright MCP session output (page snapshots, console logs)
.playwright-mcp/

# Local Git worktrees used for isolated feature development
.worktrees/

# Local environment files (secrets). The .example files are the committed templates.
.env
.env.*
!.env.example

# Ripwire installs per-machine skill symlinks and a manifest into the repo; they are
# machine-local (absolute paths under ~/.local/share/ripwire) and not portable.
.opencode/skills/ripwire-*
.opencode/skills/.ripwire-manifest-v1

# Superpowers runtime state (sdd task briefs/reports, brainstorm servers, review diffs).
.superpowers/

# Local scratch/state (state_store.db, stream_store); never commit.
data/
