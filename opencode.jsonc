{
  // opencode V2 config. Agent guidance lives in AGENTS.md; this file only wires tools.
  "$schema": "https://opencode.ai/config.json",

  // Pinned so a new upstream release never runs on this box (which also hosts
  // production) without review. Bump deliberately.
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git#v6.4.2"
  ],

  // Always loaded alongside AGENTS.md. Claude Code scopes this file to backend/**;
  // opencode has no path scoping, so it is loaded for every session.
  "instructions": [".claude/rules/architecture-invariants.md"],

  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@0.0.83",
          "--headless",
          // Default (no --browser) resolves to channel "chrome" (branded Google
          // Chrome at /opt/google/chrome/chrome), which is not installed here.
          // "chromium" maps to channel "chrome-for-testing" = the bundled Chromium
          // already in ~/.cache/ms-playwright/chromium-*.
          "--browser",
          "chromium",
          "--user-data-dir=/srv/ai/data/browser-profiles/goldys"
        ],
        "codemode": false,
        // First start may download the package; don't time out on a cold cache.
        "timeout": { "startup": 60000 }
      }
    }
  },

  // Format each edited Java file with the project's own Spotless config (same
  // google-java-format version CI checks). The IDE hook formats only the given file.
  "formatter": {
    "spotless-java": {
      "command": [
        "backend/gradlew",
        "-p",
        "backend",
        "-q",
        "spotlessApply",
        "-PspotlessIdeHook=$FILE"
      ],
      "extensions": [".java"]
    }
  },

  // Allow every non-destructive command by default; the deny rules below are the only
  // restrictions. Last matching rule wins, and deny rules apply even in auto-approve
  // mode — so the denies below override the broad allow.
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "allow" },

    // Destructive actions — hard deny. This VM also runs production (see AGENTS.md
    // "Safety"); these are the data-destroying commands, and no agent may run them.
    { "action": "shell", "resource": "*down -v*", "effect": "deny" },
    { "action": "shell", "resource": "*down --volumes*", "effect": "deny" },
    { "action": "shell", "resource": "docker volume rm*", "effect": "deny" },
    { "action": "shell", "resource": "docker volume prune*", "effect": "deny" },
    { "action": "shell", "resource": "docker system prune*", "effect": "deny" },
    { "action": "shell", "resource": "git push --force*", "effect": "deny" },
    { "action": "shell", "resource": "git push -f*", "effect": "deny" },
    // Raw filesystem deletion of Docker data (bypasses the docker CLI).
    { "action": "shell", "resource": "*rm -rf*var/lib/docker*", "effect": "deny" },

    // Secrets: never read or edit the real env file, by any tool.
    { "action": "shell", "resource": "*.env.prod*", "effect": "deny" },
    { "action": "read", "resource": "*.env.prod", "effect": "deny" },
    { "action": "edit", "resource": "*.env.prod", "effect": "deny" }
  ]
}
