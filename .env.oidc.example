# Optional OIDC configuration. Copy to `.env.oidc` ONLY when you have identity
# provider credentials — the backend reads these Spring Boot variable names
# directly. Without `.env.oidc`, the app runs with login disabled.
#
# Register this exact redirect URI with your identity provider:
#   https://platform.swd.sh/login/oauth2/code/goldys

SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOLDYS_CLIENT_ID=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOLDYS_CLIENT_SECRET=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOLDYS_SCOPE=openid,profile,email
SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_GOLDYS_ISSUER_URI=
