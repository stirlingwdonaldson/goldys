# Goldy's environment template. Copy to `.env.prod` (production) and fill in real
# values. Never commit a real env file — these are placeholders only.

# ---- Production (docker compose -f docker-compose.prod.yml) ----
# Address the frontend binds to. Use 127.0.0.1 when the edge reaches this VM over
# a tunnel (cloudflared); use 0.0.0.0 only with a host firewall restricting the
# port to the edge's IP ranges.
BIND_ADDRESS=127.0.0.1

# Host port the edge forwards platform.swd.sh to.
PORT=3000

# Database (required).
POSTGRES_DB=goldys
POSTGRES_USER=goldys
POSTGRES_PASSWORD=

# OIDC is OPTIONAL and lives in a separate file (see `.env.oidc.example`).
# Without it the app runs with login disabled (the UI shows "Sign in").

# ---- Deputy webhook (raw-only) ----
# Shared token guarding POST /api/ingest/deputy (fail-closed when unset).
# DEPUTY_DROP_TOKEN=

# ---- OpenTable manual CSV drop ----
# Shared token guarding POST /api/ingest/opentable (fail-closed when unset).
# OPENTABLE_DROP_TOKEN=
# Optional: venue timezone used to interpret GuestCenter date/time columns.
# OPENTABLE_TIMEZONE=Australia/Sydney

# ---- Cooking the Books (CTB) ----
# Session credentials for the internal AJAX endpoints (no public API).
# CTB_EMAIL=
# CTB_PASSWORD=
# CTB_BASE_URL=https://web.cookingthebooks.com.au
# Shared token guarding the invoice CSV + PDF drops
# (POST /api/ingest/ctb-invoices; fail-closed when unset). PDFs arrive over SFTP only.
# CTB_DROP_TOKEN=

# SFTP drop for the Custom Invoice Export. The `sftp` container (docker-compose.prod.yml)
# hosts it; CTB pushes the export into it and the backend polls it out. SFTP_PASSWORD is
# required to deploy — the sftp service fails without it.
# SFTP_USER=ctb
# SFTP_PASSWORD=
# SFTP_PORT=2222
# Start polling once CTB is pushing into the drop:
# CTB_SFTP_ENABLED=true
# One-off maintenance: on the next boot, replay the stored invoice PDFs through the improved
# line matcher and retire the PDF_ONLY_LINE flags it resolves. Set true, deploy, then UNSET so it
# does not re-run on every restart (re-runs are idempotent, just unnecessary).
# APP_CTB_INVOICE_REENRICH=true

# One-off detail backfill: on the next boot, fetch CTB stocktake lines, wastage lines, recipe
# ingredients and a batched recipe-cost pass into the raw ledger (connector ctb-detail-backfill).
# Set true, deploy, verify the run closes SUCCESS on read-only data, then UNSET so it does not
# re-run on every restart (re-runs append duplicate raw records).
# APP_CTB_DETAIL_BACKFILL=true

# Invoice gap recovery: create canonical invoice lines from the PDF when the CTB CSV export
# provably omits them (header reconciles with the PDF but not the CSV). OFF by default — set true,
# deploy, verify on read-only production data, then decide whether to keep it on permanently.
# Enable in stages: APP_CTB_INVOICE_GAP_RECOVERY=true -> verify -> leave true (default off).
# APP_CTB_INVOICE_GAP_RECOVERY=true

# ---- MarketMan ----
# Buyer-portal session: use EITHER email + password ...
# MARKETMAN_EMAIL=
# MARKETMAN_PASSWORD=
# ... OR a browser-session cookie (expires; refresh when calls start failing).
# MARKETMAN_COOKIE=
# MARKETMAN_BASE_URL=https://buyer.marketman.com
# Official API v3 (keys from MarketMan support; not yet requested).
# MARKETMAN_API_KEY=
# MARKETMAN_API_PASSWORD=

# ---- Lightspeed O-Series / Kounta ----
# Back-office session (the working path today).
# LIGHTSPEED_EMAIL=
# LIGHTSPEED_PASSWORD=
# Public REST API (paid add-on, +$169/mo; fill in once unlocked).
# LIGHTSPEED_CLIENT_ID=
# LIGHTSPEED_CLIENT_SECRET=

# ---- Conversational BI ("Ask Goldy's") ----
# Optional. Leave unset to keep the feature disabled (the app boots fine without it).
# OPENAI_API_KEY=
# OpenAI-compatible base URL (defaults to api.openai.com; Spring AI appends /v1).
# OPENAI_BASE_URL=
# Model name (defaults to gpt-4o-mini).
# OPENAI_MODEL=
# Must be "openai" to activate the chat model auto-config (default "none").
# SPRING_AI_MODEL_CHAT=

# ---- Forecasting (TimesFM) ----
# Self-hosted time-series model for the /forecasting page. OFF by default: enable the flag
# only after the `timesfm` service is deployed and warmed (its first /forecast downloads the
# ~1.3 GB model into the `timesfm_cache` volume).
# FORECASTING_TIMESFM_ENABLED=true
# Pre-download the model in the background at timesfm startup so the first forecast isn't
# stalled by the download. Leave unset (false) while forecasting is still disabled.
# TIMESFM_PREWARM=true
# TIMESFM_MODEL=google/timesfm-3.0-pytorch   # default
# TIMESFM_DEVICE=cpu                          # this host has no GPU

# ---- Error monitoring (Sentry, self-hosted on ops-sentry) ----
# Optional. Leave unset and both apps run with monitoring off. See docs/operations/deployment.md.
# SENTRY_BACKEND_DSN=
# SENTRY_FRONTEND_DSN=
# SENTRY_ENVIRONMENT=production
# "true" adds a "Report a problem" button that sends feedback to Sentry.
# SENTRY_FEEDBACK=false
# Source map upload during the frontend build (internal URL; the public one is behind Access).
# SENTRY_URL=http://192.168.4.41:9000
# SENTRY_ORG=
# SENTRY_AUTH_TOKEN=
# Optional: LAN address the browser-event relay forwards to, skipping Cloudflare.
# SENTRY_TUNNEL_TARGET=http://192.168.4.41:9000
