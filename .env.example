# Goldy's environment template. Copy to `.env.prod` (production) and fill in real
# values. Never commit a real env file — these are placeholders only.

# ---- Production (docker compose -f docker-compose.prod.yml) ----
# Address the frontend binds to. Use 127.0.0.1 when the edge reaches this VM over
# a tunnel (cloudflared); use 0.0.0.0 only with a host firewall restricting the
# port to the edge's IP ranges.
BIND_ADDRESS=127.0.0.1

# Host port the edge forwards platform.swd.sh to.
PORT=3000

# Database (required).
POSTGRES_DB=goldys
POSTGRES_USER=goldys
POSTGRES_PASSWORD=

# OIDC is OPTIONAL and lives in a separate file (see `.env.oidc.example`).
# Without it the app runs with login disabled (the UI shows "Sign in").

# ---- Deputy webhook (raw-only) ----
# Shared token guarding POST /api/ingest/deputy (fail-closed when unset).
# DEPUTY_DROP_TOKEN=

# ---- OpenTable manual CSV drop ----
# Shared token guarding POST /api/ingest/opentable (fail-closed when unset).
# OPENTABLE_DROP_TOKEN=
# Optional: venue timezone used to interpret GuestCenter date/time columns.
# OPENTABLE_TIMEZONE=Australia/Sydney

# ---- Cooking the Books (CTB) ----
# Session credentials for the internal AJAX endpoints (no public API).
# CTB_EMAIL=
# CTB_PASSWORD=
# CTB_BASE_URL=https://web.cookingthebooks.com.au

# ---- MarketMan ----
# Buyer-portal session: use EITHER email + password ...
# MARKETMAN_EMAIL=
# MARKETMAN_PASSWORD=
# ... OR a browser-session cookie (expires; refresh when calls start failing).
# MARKETMAN_COOKIE=
# MARKETMAN_BASE_URL=https://buyer.marketman.com
# Official API v3 (keys from MarketMan support; not yet requested).
# MARKETMAN_API_KEY=
# MARKETMAN_API_PASSWORD=

# ---- Lightspeed O-Series / Kounta ----
# Back-office session (the working path today).
# LIGHTSPEED_EMAIL=
# LIGHTSPEED_PASSWORD=
# Public REST API (paid add-on, +$169/mo; fill in once unlocked).
# LIGHTSPEED_CLIENT_ID=
# LIGHTSPEED_CLIENT_SECRET=

# ---- Xero (candidate accounting source) ----
# Read-only OAuth scopes only; a live Xero connection already exists via MarketMan.
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
# XERO_TENANT_ID=

# ---- Conversational BI ("Ask Goldy's") ----
# Optional. Leave unset to keep the feature disabled (the app boots fine without it).
# OPENAI_API_KEY=
# OpenAI-compatible base URL (defaults to api.openai.com; Spring AI appends /v1).
# OPENAI_BASE_URL=
# Model name (defaults to gpt-4o-mini).
# OPENAI_MODEL=
# Must be "openai" to activate the chat model auto-config (default "none").
# SPRING_AI_MODEL_CHAT=
