[Unit]
Description=Goldys Pi isolated preview worker
Requires=docker.service goldys-sandbox.service
After=docker.service goldys-sandbox.service

[Service]
Type=simple
EnvironmentFile=/etc/goldys-agent/worker.conf
LoadCredential=model-api-key:/etc/goldys-agent/deepseek-api-key
LoadCredential=worker-token:/etc/goldys-agent/worker-token
RuntimeDirectory=goldys-pi-worker
RuntimeDirectoryMode=0700
ExecStartPre=/usr/bin/python3 -B /opt/goldys-agent/configure-egress.py
ExecStartPre=/usr/bin/install -m 0400 -o 65532 -g 65532 %d/model-api-key /run/goldys-pi-worker/model-api-key
ExecStartPre=/usr/bin/install -m 0400 -o 65532 -g 65532 %d/worker-token /run/goldys-pi-worker/worker-token
ExecStart=/usr/bin/docker run --rm --name goldys-pi-worker-preview --network=host --read-only --user=65532:65532 --cap-drop=ALL --security-opt=no-new-privileges --memory=768m --memory-swap=768m --cpus=0.75 --pids-limit=64 --log-driver=none --tmpfs=/tmp:rw,nosuid,nodev,size=128m,mode=1777 --mount=type=bind,src=/run/goldys-sandbox,dst=/run/goldys-sandbox,readonly --mount=type=bind,src=/run/goldys-pi-worker/model-api-key,dst=/run/credentials/model-api-key,readonly --mount=type=bind,src=/run/goldys-pi-worker/worker-token,dst=/run/credentials/worker-token,readonly --mount=type=bind,src=/opt/goldys-agent/preview-ca.crt,dst=/opt/goldys-agent/preview-ca.crt,readonly --mount=type=bind,src=/opt/goldys-agent/extract.py,dst=/opt/goldys-agent/extract.py,readonly --mount=type=bind,src=/opt/goldys-agent/validate_outputs.py,dst=/opt/goldys-agent/validate_outputs.py,readonly --env=CREDENTIALS_DIRECTORY=/run/credentials --env=NODE_EXTRA_CA_CERTS=/opt/goldys-agent/preview-ca.crt --env=GOLDYS_SPRING_ORIGIN=https://localhost:18443 --env=GOLDYS_MODEL_PROVIDER=goldys-deepseek --env=GOLDYS_MODEL_ID=deepseek-flash --env=GOLDYS_MODEL_REQUEST_BOUND_AUD=0.65 --env=GOLDYS_MODEL_MAX_OUTPUT_TOKENS=8192 --env=GOLDYS_SANDBOX_ENABLED=true --env=GOLDYS_PUBLIC_RESEARCH_ENABLED=true ${GOLDYS_WORKER_IMAGE}
ExecStop=/usr/bin/docker stop --time=8 goldys-pi-worker-preview
ExecStopPost=-/usr/bin/docker rm -f goldys-pi-worker-preview
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077

[Install]
WantedBy=multi-user.target
