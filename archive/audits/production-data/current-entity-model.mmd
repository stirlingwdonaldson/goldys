    %% Solid lines: enforced PostgreSQL FK. Dotted lines: application/natural-key relation only.
    ingestion_run ||--o{ raw_record : ingestion_run_id
    ingestion_run ||--o{ ingestion_failure : ingestion_run_id
    raw_record ||--o{ canonical_daily_sales : raw_record_id
    raw_record ||--o{ canonical_product_sales : raw_record_id
    raw_record ||--o{ canonical_invoice : raw_record_id
    raw_record ||--o{ canonical_invoice_line : raw_record_id
